---
import ThemeToggle from './ThemeToggle.astro';
import { content } from '@/lib/data';
import { url } from '@/lib/slug';

const { site, profile } = content;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === url(href) || path.startsWith(url(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/65">
  <div class="container-wide flex h-16 items-center justify-between gap-4">
    <a href={url()} class="group flex items-center gap-2.5 text-ink" aria-label={`${profile.name} — home`}>
      <span class="relative grid size-7 place-items-center rounded-full border border-line-strong" aria-hidden="true">
        <span class="size-1.5 rounded-full bg-signal transition-transform duration-500 ease-(--ease-signal) group-hover:scale-150"></span>
      </span>
      <span class="text-[0.95rem] font-medium tracking-tight">{profile.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="rounded-full px-3 py-1.5 text-sm text-muted transition-colors hover:text-ink aria-[current=page]:text-ink aria-[current=page]:bg-raised"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <button
        type="button"
        class="grid size-9 place-items-center rounded-full border border-line text-muted hover:text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-button
      >
        <span class="sr-only">{site.labels.menu}</span>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 8h16M4 16h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="border-t border-line bg-bg lg:hidden" hidden>
    <nav aria-label="Primary mobile" class="container-wide py-4">
      <ul class="grid gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="flex items-baseline justify-between rounded-md px-2 py-2.5 text-lg text-muted hover:text-ink aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.getElementById('mobile-menu');
  if (button && menu) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
