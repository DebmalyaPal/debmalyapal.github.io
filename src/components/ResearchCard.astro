---
import Tag from './Tag';
import type { Theme } from '@/lib/schema';
import { content } from '@/lib/data';
import { projectUrl, url } from '@/lib/slug';

interface Props {
  theme: Theme;
  index: number;
}

const { theme, index } = Astro.props;
const { projects, publications, site } = content;
const { labels } = site;
const related = projects.filter((p) => p.themes.includes(theme.id));
const pubs = publications.filter((p) => p.themes.includes(theme.id));
---

<article id={`theme-${theme.id}`} class="grid scroll-mt-24 gap-6 border-t border-line py-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
  <div>
    <p class="eyebrow mb-4">{String(index + 1).padStart(2, '0')} · {theme.short}</p>
    <h3 class="text-[clamp(1.6rem,1.3rem+1.2vw,2.3rem)] leading-[1.08] font-medium tracking-tight text-ink">{theme.title}</h3>
    <p class="mt-4 font-display text-xl leading-snug text-muted italic">{theme.question}</p>
    <p class="mt-4 max-w-xl leading-relaxed text-muted">{theme.summary}</p>
    {
      theme.keywords.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2" aria-label={labels.keywords}>
          {theme.keywords.map((k) => (
            <li>
              <Tag tone="signal">{k}</Tag>
            </li>
          ))}
        </ul>
      )
    }
    <a href={url(`research/?theme=${theme.id}#atlas`)} class="mt-6 inline-flex items-center gap-2 text-sm text-muted hover:text-ink">
      {labels.exploreTheme} <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
    {
      related.length > 0 && (
        <div>
          <h4 class="eyebrow mb-3">{labels.projects}</h4>
          <ul>
            {related.map((p) => (
              <li class="border-t border-line py-3">
                <a href={projectUrl(p.slug)} class="text-ink hover:text-signal">
                  {p.shortTitle}
                </a>
                <p class="mt-1 text-sm leading-snug text-muted">{p.summary}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      pubs.length > 0 && (
        <div>
          <h4 class="eyebrow mb-3">{labels.publications}</h4>
          <ul>
            {pubs.map((p) => (
              <li class="border-t border-line py-3">
                <p class="leading-snug text-ink">{p.title}</p>
                <p class="mt-1 font-mono text-[0.7rem] text-faint">
                  {p.venueShort} · {p.year}
                </p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>
