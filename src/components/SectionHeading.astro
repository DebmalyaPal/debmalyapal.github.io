---
interface Props {
  id: string;
  eyebrow?: string | undefined;
  heading: string;
  /** Optional "see all" link rendered at the right edge. */
  link?: { href: string; label: string } | undefined;
}

const { id, eyebrow, heading, link } = Astro.props;
---

<div class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
  <div>
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h2 id={id} class="max-w-3xl text-title font-medium tracking-tight text-ink">{heading}</h2>
  </div>
  {
    link && (
      <a href={link.href} class="group inline-flex items-center gap-2 text-sm text-muted hover:text-ink">
        {link.label}
        <span aria-hidden="true" class="transition-transform duration-500 ease-(--ease-signal) group-hover:translate-x-1">
          →
        </span>
      </a>
    )
  }
</div>
