---
import Tag from './Tag';
import type { Education } from '@/lib/schema';
import { content } from '@/lib/data';
import { formatRange } from '@/lib/format';

interface Props {
  item: Education;
  headingLevel?: 'h2' | 'h3';
}

const { item: e, headingLevel = 'h3' } = Astro.props;
const { labels } = content.site;
const H = headingLevel;
---

<article class="grid gap-3 border-t border-line py-8 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-10">
  <p class="font-mono text-xs leading-relaxed text-faint">{formatRange(e.start, e.end)}</p>
  <div class="min-w-0">
    <H class="text-xl leading-snug font-medium text-ink">
      {e.degree}
      {e.specialization && <span class="font-display text-muted italic"> — {e.specialization}</span>}
    </H>
    <p class="mt-1.5 text-base leading-snug text-muted">{e.institution}</p>
    {(e.unit || e.location) && <p class="mt-1 text-sm text-faint">{[e.unit, e.location].filter(Boolean).join(' · ')}</p>}
    {
      e.gpa && (
        <p class="mt-3 text-sm">
          <span class="text-faint">{labels.gpa}</span> <span class="text-ink tabular-nums">{e.gpa}</span>
        </p>
      )
    }
    {
      e.coursework.length > 0 && (
        <div class="mt-4">
          <p class="eyebrow mb-2">{labels.coursework}</p>
          <ul class="flex flex-wrap gap-2">
            {e.coursework.map((c) => (
              <li>
                <Tag>{c}</Tag>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>
