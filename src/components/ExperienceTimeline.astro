---
import Tag from './Tag';
import { content } from '@/lib/data';
import { groupByOrganization, organizationRepeatsRole } from '@/lib/group';
import { formatRange } from '@/lib/format';
import { projectUrl } from '@/lib/slug';

interface Props {
  /** Compact mode shows roles, organizations and dates only, for the homepage. */
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { compact = false, headingLevel = 'h2' } = Astro.props;
const { experience, projects, site } = content;
const { labels, enums } = site;
const groups = groupByOrganization(experience);
const projectTitle = Object.fromEntries(projects.map((p) => [p.slug, p.shortTitle]));
const H = headingLevel;
---

<ol class="relative">
  {
    groups.map((g) => (
      <li class="relative grid gap-4 border-t border-line py-10 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-10">
        <div class="flex items-start gap-3 md:flex-col md:gap-2">
          <span
            class:list={['mt-1.5 size-2 shrink-0 rounded-full', g.kind === 'research' ? 'bg-signal' : 'bg-pulse']}
            aria-hidden="true"
          />
          <p class="font-mono text-xs leading-relaxed text-faint">{formatRange(g.start, g.end)}</p>
          <p class="eyebrow md:mt-1">{enums.experienceKind[g.kind]}</p>
        </div>
        <div class="min-w-0">
          {/*
            Each appointment leads with the role; the organization sits directly beneath it.
            Consecutive roles at one organization share that line, shown once under the most
            recent role, with earlier roles nested below on a rule.
          */}
          <ol class:list={['grid', compact ? 'gap-5' : 'gap-10']}>
            {g.roles.map((r, i) => (
              <li class:list={[i > 0 && 'relative border-l border-line pl-5']}>
                {i > 0 && <span class="absolute top-2.5 -left-[3px] size-[5px] rounded-full bg-line-strong" aria-hidden="true" />}
                {/* Capped at the body-text measure so per-role dates align with the text column, not the page edge. */}
                <div class="flex max-w-3xl flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <H
                    class:list={[
                      'font-medium tracking-tight text-ink',
                      i === 0 ? 'text-[1.4rem] leading-tight md:text-[1.65rem]' : 'text-lg leading-snug md:text-xl',
                    ]}
                  >
                    {r.role}
                  </H>
                  {g.roles.length > 1 && <p class="font-mono text-xs whitespace-nowrap text-faint">{formatRange(r.start, r.end)}</p>}
                </div>
                {i === 0 && !organizationRepeatsRole(r.role, g.organization) && (
                  <p class="mt-1 text-base leading-snug text-muted md:text-[1.05rem]">{g.organization}</p>
                )}
                {(r.unit || r.location) && <p class="mt-1 text-sm text-faint">{[r.unit, r.location].filter(Boolean).join(' · ')}</p>}
                {!compact && (
                  <>
                    {(r.advisor || r.client) && (
                      <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm">
                        {r.advisor && (
                          <div class="flex gap-2">
                            <dt class="text-faint">{labels.advisor}</dt>
                            <dd class="text-ink">{r.advisor}</dd>
                          </div>
                        )}
                        {r.client && (
                          <div class="flex gap-2">
                            <dt class="text-faint">{labels.client}</dt>
                            <dd class="text-ink">{r.client}</dd>
                          </div>
                        )}
                      </dl>
                    )}
                    {r.summary && <p class="mt-4 max-w-3xl leading-relaxed text-muted">{r.summary}</p>}
                    {r.highlights.length > 0 && (
                      <ul class="tick-list mt-4 grid max-w-3xl gap-2.5 text-[0.95rem] leading-relaxed text-muted">
                        {r.highlights.map((h) => (
                          <li>{h}</li>
                        ))}
                      </ul>
                    )}
                    {(r.stack.length > 0 || r.projects.length > 0) && (
                      <div class="mt-5 flex flex-wrap items-center gap-2">
                        {r.projects.map((slug) => (
                          <a
                            href={projectUrl(slug)}
                            class="inline-flex items-center gap-1.5 rounded-full border border-signal/40 px-2.5 py-0.5 font-mono text-[0.68rem] text-signal hover:bg-signal-soft"
                          >
                            {projectTitle[slug]} <span aria-hidden="true">→</span>
                          </a>
                        ))}
                        {r.stack.length > 0 && (
                          <ul class="flex flex-wrap gap-2" aria-label={labels.stack}>
                            {r.stack.map((s) => (
                              <li>
                                <Tag>{s}</Tag>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    )}
                  </>
                )}
              </li>
            ))}
          </ol>
        </div>
      </li>
    ))
  }
</ol>
