---
import { content } from '@/lib/data';
import { url } from '@/lib/slug';

const { site, profile } = content;
const socials = [
  { label: site.labels.email, href: `mailto:${profile.contact.email}` },
  { label: site.labels.github, href: profile.contact.github },
  { label: site.labels.linkedin, href: profile.contact.linkedin },
  { label: site.labels.scholar, href: profile.contact.scholar },
  { label: site.labels.orcid, href: profile.contact.orcid },
].filter((s): s is { label: string; href: string } => Boolean(s.href));
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="container-wide grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-3xl leading-tight text-ink">{profile.name}</p>
      <p class="mt-3 text-sm text-ink">{profile.position}</p>
      <p class="mt-0.5 text-sm text-muted">{profile.institution}</p>
    </div>
    <nav aria-label="Footer">
      <p class="eyebrow mb-3">{site.labels.sitemap}</p>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
        {site.nav.map((item) => <li><a class="text-muted hover:text-ink" href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="eyebrow mb-3">{site.labels.elsewhere}</p>
      <ul class="grid gap-1.5 text-sm">
        {
          socials.map((s) => (
            <li>
              <a class="text-muted hover:text-ink" href={s.href} {...(s.href.startsWith('http') ? { rel: 'me noopener' } : {})}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="container-wide py-6 text-xs text-faint">© {year} {profile.name}</p>
  </div>
</footer>
