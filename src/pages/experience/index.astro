---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import { content } from '@/lib/data';

const page = content.site.pages.experience;
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeader eyebrow={page.eyebrow} heading={page.heading ?? page.title} lede={page.lede} />
  <div class="container-wide py-8 md:py-12">
    <ExperienceTimeline />
  </div>
</BaseLayout>
