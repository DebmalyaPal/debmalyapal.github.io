---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectFilters from '@/islands/ProjectFilters';
import { content } from '@/lib/data';
import { themeNames } from '@/lib/atlas';

const { site, research, projects } = content;
const { labels, enums, pages } = site;
const page = pages.projects;
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeader eyebrow={page.eyebrow} heading={page.heading ?? page.title} lede={page.lede} />
  <div class="container-wide py-12 md:py-16">
    {/* Rendered on the server with every project visible, so the list is complete without JavaScript. */}
    <ProjectFilters
      client:idle
      projects={projects}
      themes={research.themes.map((t) => ({ id: t.id, short: t.short }))}
      labels={labels}
      enums={enums}
      themeNames={themeNames(content)}
    />
  </div>
</BaseLayout>
