---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { content } from '@/lib/data';
import { url } from '@/lib/slug';

const { site, profile } = content;
const { labels, pages } = site;
const page = pages.contact;
const { contact } = profile;

// Only channels present in profile.json are listed; null entries are skipped entirely.
const profiles = [
  { label: labels.github, href: contact.github, handle: contact.githubHandle },
  { label: labels.linkedin, href: contact.linkedin, handle: contact.linkedinHandle },
  { label: labels.scholar, href: contact.scholar, handle: null },
  { label: labels.orcid, href: contact.orcid, handle: null },
  { label: labels.cv, href: contact.cv ? url(contact.cv) : null, handle: null },
].filter((p): p is { label: string; href: string; handle: string | null } => Boolean(p.href));
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeader eyebrow={page.eyebrow} heading={page.heading ?? page.title} lede={profile.collaborationNote} />

  <div class="container-wide grid gap-14 py-14 md:py-20 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
    <section aria-labelledby="email-heading">
      <h2 id="email-heading" class="eyebrow mb-5">{labels.writeTo}</h2>
      <a
        href={`mailto:${contact.email}`}
        class="group inline-flex max-w-full items-baseline gap-3 font-display text-[clamp(1.6rem,0.9rem+3vw,3.5rem)] leading-none break-all text-ink hover:text-signal"
      >
        {contact.email}
        <span aria-hidden="true" class="font-sans text-[0.5em] transition-transform duration-500 ease-(--ease-signal) group-hover:translate-x-1.5">→</span>
      </a>
      <div class="mt-8">
        <p class="text-base font-medium text-ink">{profile.position}</p>
        <p class="mt-1 text-sm text-muted">{profile.institution}</p>
        <p class="mt-1 text-sm text-faint">{[profile.department, profile.location].filter(Boolean).join(' · ')}</p>
      </div>
    </section>

    {
      profiles.length > 0 && (
        <section aria-labelledby="profiles-heading">
          <h2 id="profiles-heading" class="eyebrow mb-5">
            {labels.reachOut}
          </h2>
          <ul>
            {profiles.map((p) => (
              <li class="border-t border-line last:border-b">
                <a href={p.href} rel="me noopener" target="_blank" class="group flex items-baseline justify-between gap-4 py-5">
                  <span class="text-xl text-ink group-hover:text-signal">{p.label}</span>
                  <span class="truncate font-mono text-xs text-faint">
                    {p.handle ?? ''} <span aria-hidden="true">↗</span>
                    <span class="sr-only">(opens in a new tab)</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
