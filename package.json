{
  "name": "debmalyapal-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run blog:validate && astro check && astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:blog-cli && npm run build && npm run test:e2e && npm run test:blog-build",
    "lighthouse": "lighthouse http://localhost:4321/ --view --chrome-flags=\"--headless=new\" --output-path=./lighthouse-report.html",
    "blog:new": "node scripts/blog.mjs new",
    "blog:validate": "node scripts/blog.mjs validate",
    "blog:publish": "node scripts/blog.mjs publish",
    "test:blog-cli": "node --test tests/blog-cli.test.mjs",
    "test:blog-build": "node --test --test-timeout=300000 tests/blog-build.test.mjs",
    "test:e2e:browsers": "ALL_BROWSERS=1 playwright test --project=firefox --project=webkit"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lighthouse": "^13.6.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
